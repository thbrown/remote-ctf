# Copy to /etc/hostapd/hostapd.conf and adjust ssid/wpa_passphrase to match
# WIFI_SSID / WIFI_PSK in your Hub environment. See ops/raspberry-pi-ap-setup.md.

interface=wlan0
driver=nl80211

ssid=FoundryCTF
hw_mode=g
channel=6
country_code=US
ieee80211d=1
ieee80211n=1
wmm_enabled=1

auth_algs=1
wpa=2
wpa_passphrase=capturetheflag
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
